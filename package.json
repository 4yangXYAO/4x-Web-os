{
  "name": "na-os",
  "version": "0.1.0",
  "description": "A high-performance operating system that runs in the browser",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\""
  },
  "dependencies": {
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "fastify": "^4.25.1",
    "framer-motion": "^10.16.4",
    "lucide-solid": "^0.300.0",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2",
    "solid-js": "^1.8.0",
    "tailwindcss": "^3.3.6",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^9.3.4",
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.10.6",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.56.0",
    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "solid-testing-library": "^0.5.1",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vite-plugin-solid": "^2.8.0",
    "vitest": "^1.0.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
